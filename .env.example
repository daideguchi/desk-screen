# Desk Screen env (example)
# Copy to `.env` and edit.

# 固定ポートにしたい場合（タブレット側URLを固定したい）
# DESK_SCREEN_PORT=49662

# Calendar source:
# - auto  : Google OAuth → Google SA → AppleScript の順で試行
# - google: Google優先（失敗時エラー表示 + フォールバック）
# - apple : Apple Calendarのみ
DESK_SCREEN_CALENDAR_SOURCE=auto

# Calendar range（例: 1m / 4w / 14d / 7）
DESK_SCREEN_CALENDAR_RANGE=1m

# OAuthカレンダーの対象（primary / selected / all）
DESK_SCREEN_GOOGLE_CALENDAR_MODE=selected

# ToDo書き込み保護（任意）
# - 未設定でも動くが、LAN内でも誤操作を防ぎたいなら設定推奨
# DESK_SCREEN_TODO_TOKEN=change-me

# Weather / Temp (Open‑Meteo)
# - 都市名で指定（ジオコーディング）
# DESK_SCREEN_WEATHER_CITY=Fukuoka
#
# - 緯度経度で指定（任意で表示名）
# DESK_SCREEN_WEATHER_LAT=33.5892504
# DESK_SCREEN_WEATHER_LON=130.3927565
# DESK_SCREEN_WEATHER_LABEL=福岡市 中央区
